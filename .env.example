# Kopiera till .env och fyll i värdena därifrån. .env är gitignorerad.
#
# ENDAST publishable-nyckeln får stå här eller i frontendkoden. Den är publik
# by design och skyddas av RLS.
#
# Secret-nyckeln (sb_secret_...) och databaslösenordet får ALDRIG hamna i en
# VITE_-variabel — allt med det prefixet bakas in i det publika bygget.
# De hör hemma i Supabase egna secrets för Edge Functions, inget annat ställe.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
